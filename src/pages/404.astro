---
import Base from '../layouts/Base.astro';
---

<Base lang="en" path="/" title="Not found">
  <div class="page-top">
    <div class="wrap">
      <p class="mono">404</p>
      <h1>This page is <span class="hl">not in the catalog.</span></h1>
      <p class="lede">Halaman ini tidak ada di katalog.</p>
      <div class="actions">
        <a class="btn primary" href="/">Back to KHYR Labs</a>
        <a class="btn ghost" href="/id/">Kembali ke beranda</a>
      </div>
    </div>
  </div>
</Base>
