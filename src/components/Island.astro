---
import Flo from './Flo.astro';
import { t, localePath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  altHref: string;
  timezone: string;
}
const { lang, altHref, timezone } = Astro.props;
const home = localePath(lang, '/');
const links = [
  { href: `${home}#tools`, label: t(lang, 'nav_tools') },
  { href: localePath(lang, '/work/'), label: t(lang, 'nav_work'), work: true },
  { href: `${home}#notes`, label: t(lang, 'nav_notes') },
  { href: `${home}#support`, label: t(lang, 'nav_support') },
];
---

<header class="island" id="island" data-tz={timezone} transition:persist={`island-${lang}`}>
  <a class="home" href={home} aria-label="KHYR Labs">
    <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
      <line x1="14" y1="9" x2="14" y2="91" stroke="currentColor" stroke-width="17" stroke-linecap="round"></line>
      <polyline points="89,9 43,50 89,91" fill="none" stroke="#F2994A" stroke-width="17" stroke-linecap="round" stroke-linejoin="round"></polyline>
    </svg>
    <Flo class="mini-flo" />
  </a>
  <span class="clock" id="clock" aria-live="off"></span>
  <nav id="nav" aria-label="Main">
    {links.map((l) => <a href={l.href} data-work={l.work ? '' : undefined}>{l.label}</a>)}
  </nav>
  <div class="ctl">
    <button class="menu" id="menuBtn" type="button" aria-expanded="false" aria-controls="nav">{t(lang, 'menu')}</button>
    <a class="lang" id="langBtn" href={altHref} hreflang={lang === 'en' ? 'id' : 'en'} aria-label={t(lang, 'lang_switch')}>
      {t(lang, 'lang_short')}
    </a>
    <button id="themeBtn" type="button" aria-label={t(lang, 'theme_switch')}>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" style="display:block;margin:auto">
        <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Theme: remembered in localStorage; re-applied after every client-side swap
  // because the new page's <html> replaces the attributes.
  function storedTheme() {
    try { return localStorage.getItem('khyr-theme'); } catch { return null; }
  }
  function applyTheme(doc: Document = document) {
    const t = storedTheme();
    if (t === 'light' || t === 'dark') doc.documentElement.dataset.theme = t;
  }
  document.addEventListener('astro:after-swap', () => applyTheme());
  document.addEventListener('astro:before-swap', (e) => applyTheme((e as any).newDocument));

  function curTheme() {
    return root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  }

  // Clock: time only, never the city.
  let fmt: Intl.DateTimeFormat | null = null;
  function tick() {
    const clock = document.getElementById('clock');
    const island = document.getElementById('island');
    if (!clock || !island) return;
    fmt ??= new Intl.DateTimeFormat('en-GB', { timeZone: island.dataset.tz || 'Asia/Jakarta', hour: '2-digit', minute: '2-digit' });
    clock.textContent = fmt.format(new Date());
  }
  setInterval(tick, 20000);

  // Same-page section links (Tools, Notes, Support) get the same view transition.
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as Element | null)?.closest('a');
    if (!a || !a.hash || a.target || a.origin !== location.origin || a.pathname !== location.pathname) return;
    const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
    if (!el) return;
    e.preventDefault();
    const jump = () => {
      history.replaceState(history.state, '', a.href);
      el.scrollIntoView({ behavior: 'instant', block: 'start' });
    };
    if (document.startViewTransition && !reduceMotion) {
      root.style.scrollBehavior = 'auto';
      document.startViewTransition(jump).finished.finally(() => { root.style.scrollBehavior = ''; });
    } else jump();
  }, true);

  document.addEventListener('astro:before-preparation', () => { root.style.scrollBehavior = 'auto'; });

  function setup() {
    root.style.scrollBehavior = '';
    const island = document.getElementById('island');
    const menuBtn = document.getElementById('menuBtn');
    const langBtn = document.getElementById('langBtn') as HTMLAnchorElement | null;
    if (!island || !menuBtn) return;

    tick();
    // The new page knows its own other-language address.
    if (langBtn && root.dataset.alt) langBtn.href = root.dataset.alt;
    const onWork = /\/work\//.test(location.pathname);
    island.querySelectorAll('nav a').forEach((a) => {
      if ((a as HTMLElement).dataset.work !== undefined && onWork) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    island.classList.remove('menu-open');
    menuBtn.setAttribute('aria-expanded', 'false');

    if (island.dataset.ready) return; // persisted island: wire it once
    island.dataset.ready = '1';
    setTimeout(() => island.classList.add('open'), reduceMotion ? 0 : 500);
    menuBtn.addEventListener('click', () => {
      const open = island.classList.toggle('menu-open');
      menuBtn.setAttribute('aria-expanded', String(open));
    });
    island.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => {
      island.classList.remove('menu-open');
      menuBtn.setAttribute('aria-expanded', 'false');
    }));
    document.getElementById('themeBtn')?.addEventListener('click', () => {
      const next = curTheme() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('khyr-theme', next); } catch {}
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && island.classList.contains('menu-open')) {
        island.classList.remove('menu-open');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.focus();
      }
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
